{
  "manifest_version": 3,
  "name": "Trucker Helper",
  "short_name": "Trucker Helper",
  "default_locale": "en",
  "description": "__MSG_description__",
  "version": "1.1.2",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "unlimitedStorage", "notifications", "alarms"],
  "host_permissions": ["https://mail.google.com/*", "https://www.kdocs.cn/*", "https://support.cosco-usa.com/*", "https://coscoshippingla.freshdesk.com/*", "https://www.one-line.com/*", "https://one-line.my.site.com/*", "https://*.one-line.com/*", "https://app.draydog.com/*", "https://www.matson.com/*", "https://rtr.home.oocl.com/*", "https://exiamfw.home.oocl.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["gmail-autocc.js"], "run_at": "document_idle"}],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "Trucker Helper", "default_popup": "app.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}
}
