{
  "manifest_version": 3,
  "name": "LFD Inquiry",
  "description": "自动识别船公司和 MBL，按船公司或码头分类型配置询问邮件，保留 Gmail 签名；COSCO 通过工单网站提交，ONE 通过在线客服。",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "unlimitedStorage", "notifications"],
  "host_permissions": ["https://mail.google.com/*", "https://www.kdocs.cn/*", "https://support.cosco-usa.com/*", "https://coscoshippingla.freshdesk.com/*", "https://www.one-line.com/*", "https://one-line.my.site.com/*", "https://*.one-line.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["gmail-autocc.js"], "run_at": "document_idle"}],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "LFD Inquiry", "default_popup": "app.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}
}
