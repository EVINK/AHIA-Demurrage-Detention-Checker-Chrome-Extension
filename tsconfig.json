{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "jsx": "preserve", "types": ["chrome", "vite/client"], "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
